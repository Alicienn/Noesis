{
  "name": "noesis",
  "version": "1.0.0",
  "private": true,
  "description": "Noesis — autonomous deep-research harness: multi-agent, long-term memory, tools, live dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "tsx scripts/smoke-tools.ts",
    "mock-llm": "tsx scripts/mock-llm.ts",
    "e2e": "tsx scripts/e2e-mock.ts",
    "lean:smoke": "tsx scripts/lean/smoke-lean.ts",
    "bench:openai-math": "tsx scripts/lean/openai-math.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@mozilla/readability": "^0.6.0",
    "fastify": "^5.2.0",
    "linkedom": "^0.18.0",
    "nanoid": "^5.0.9",
    "node-notifier": "^10.0.1",
    "tsx": "^4.19.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^1.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/node-notifier": "^8.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^5.0.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "highlight.js": "^11.11.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.540.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-2d": "^1.26.0",
    "react-markdown": "^10.0.0",
    "react-router-dom": "^7.1.0",
    "rehype-highlight": "^7.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.2"
  }
}
